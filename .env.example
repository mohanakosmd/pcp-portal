# Copy to .env.local for local development and fill in values.
# In production these are provided by Firebase App Hosting:
#   - NEXT_PUBLIC_* and other non-secret values live in apphosting.yaml
#   - secrets (PCP_SESSION_SECRET, SENDGRID_API_KEY, GEMINI_API_KEY) live in
#     Cloud Secret Manager (see DEPLOY.md)

# --- Public Firebase web config (safe to expose; shipped in client bundle) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Absolute base URL of the deployed app (used for links in notification emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only config ------------------------------------------------------
SENDGRID_SENDER_EMAIL=
SIGNUP_OTP_RECIPIENT=

# --- Secrets (never commit real values) --------------------------------------
# Must be >= 16 chars; generate a strong random value for production.
PCP_SESSION_SECRET=
SENDGRID_API_KEY=
GEMINI_API_KEY=
# Optional: override the default Gemini model
GEMINI_MODEL=
