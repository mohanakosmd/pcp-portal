rules_version = '2';

// Firebase Storage security rules for project aigicare-hipaa.
//
// Deploy: `firebase deploy --only storage --project aigicare-hipaa`.
// The first deploy prompts to let Storage rules read Firestore (needed for
// the ownership lookup below) — accept it.
//
// Case objects live at `pcp_cases/{caseId}/...`. Access requires a signed-in
// Firebase Auth user whose uid equals the case's `ownerUserId` in Firestore.
//
// NOTE: the portal currently uses its own session auth, not Firebase Auth, so
// `request.auth` is always null and these rules deny every client request.
// Case documents are stored in Firestore today (src/lib/case-files.ts);
// nothing uploads here. Objects uploaded earlier stay reachable only through
// their tokenized download URLs, which bypass rules.

service firebase.storage {
  match /b/{bucket}/o {
    function isCaseOwner(caseId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/pcp_cases/$(caseId))
        && firestore.get(/databases/(default)/documents/pcp_cases/$(caseId)).data.ownerUserId
           == request.auth.uid;
    }

    match /pcp_cases/{caseId}/{allPaths=**} {
      allow read, write: if isCaseOwner(caseId);
    }

    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
