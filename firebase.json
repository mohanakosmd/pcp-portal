{
  "apphosting": {
    "backendId": "pcp-portal",
    "rootDir": ".",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      ".env*",
      "firebase-empty",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "hosting": {
    "site": "pcp-portal",
    "public": "firebase-empty",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "pcp-portal",
          "region": "us-central1"
        }
      }
    ]
  }
}
